{
  "buildCommand": "bash build-vercel.sh",
  "installCommand": "bun install",
  "framework": null,
  "redirects": [
    {
      "source": "/book",
      "destination": "/free-audit",
      "permanent": true
    }
  ],
  "crons": [
    {
      "path": "/api/cron/publish",
      "schedule": "* * * * *"
    },
    {
      "path": "/api/cron/pipeline-worker",
      "schedule": "* * * * *"
    },
    {
      "path": "/api/cron/refresh-tokens",
      "schedule": "0 0 * * *"
    },
    {
      "path": "/api/cron/collect-analytics",
      "schedule": "0 3 * * *"
    }
  ]
}
