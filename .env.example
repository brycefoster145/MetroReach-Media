# MetroReach Media — Required Environment Variables
# Copy this to .env.local and fill in real values.
# Never commit .env.local — it's already in .gitignore.

# ── Neon Postgres ──
DATABASE_URL=

# ── Meta Ads (Facebook/Instagram Ads API) ──
META_ACCESS_TOKEN=
META_USER_ID=

# ── Client Portal Auth ──
# REQUIRED (production). Strong random value (32+ chars) used to sign client-portal
# JWTs. Generate with: openssl rand -base64 48
CLIENT_AUTH_SECRET=
# ── Internal Admin API Key ──
# Shared secret for internal admin endpoints (x-api-key header) and the email API.
# Must be a strong random value; the server rejects requests without a match.
MS_API_KEY=

# ── Microsoft Graph (OAuth2, Email) ──
MS_CLIENT_ID=
MS_CLIENT_SECRET=
MS_TENANT_ID=

# ── Notion ──
NOTION_API_KEY=

# ── SendGrid (Transactional Email) ──
SENDGRID_API_KEY=

# ── Stripe (Payments) ──
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Buffer GraphQL token (channel creation/disconnect still require manual OAuth)
BUFFER_ACCESS_TOKEN=
# Admin notification destination for manual Buffer channel setup
BUFFER_CHANNEL_ADMIN_EMAIL=support@metroreachagency.com

# ── Cron Endpoints ──
# Shared secret for cron endpoints (X-Cron-Secret header, e.g. /api/cron/collect-analytics,
# /api/cron/delegate-tasks). If unset, cron endpoints skip the auth check.
CRON_SECRET=
# ── Telegram (Lead Notifications) ──
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ── Google Ads (Blocked — credentials needed from owner) ──
# GOOGLE_ADS_ACCESS_TOKEN=
# GOOGLE_ADS_DEVELOPER_TOKEN=

# ── Google Analytics (Blocked — credentials needed from owner) ──
# GOOGLE_ANALYTICS_ACCESS_TOKEN=

# ── TikTok Ads (Blocked — LLC/EIN needed first) ──
# TIKTOK_ACCESS_TOKEN=
